			"lines": [
				{
					"kind": "Valor",
					"name": "Bravoure",
					"doc": "Unit will flee the glade when [Valor] drops to 0. They gradually recover while the unit stays inside its building.",
					"def": 40
				},
				{
					"kind": "Armor",
					"name": "Armure",
					"doc": "[Armor] must drop to 0 before an unit starts loosing [Valor]. They never recover. Projectiles are less efficient against armor.",
					"def": 10
				},
				{
					"kind": "MoveSpeed",
					"name": "Vitesse",
					"doc": "Movement speed on the terrain in (meters / turn).",
					"def": 0.3
				},
				{
					"kind": "WorkSpeed",
					"name": "Vitesse de travail",
					"doc": "In (work action / turn). Determines the interval between each work action (gather 1 resource, deposit 1 resource, build for 1 material...).",
					"def": 0.1
				},
				{
					"kind": "Force",
					"name": "Force",
					"doc": "For [Melee] units, determines the damages dealt by each attack. For [Ranged] units, determines the range of the projectile.",
					"def": 4
				},
				{
					"kind": "AttackSpeed",
					"name": "Vitesse d'attaque",
					"doc": "In (attack / turn). Determines the interval between each attack.",
					"def": 0.1
				},
				{
					"kind": "BlockChance",
					"name": "Chance de parade",
					"doc": "Chances of parrying a [Melee] attack.",
					"def": 0.1
				},
				{
					"kind": "CriticalChance",
					"name": "Critique",
					"doc": "Chances of inflicting a critical hit x[constant.CriticalFactor] damages.",
					"def": 0.2
				},
				{
					"kind": "Precision",
					"name": "Précision",
					"doc": "Chances of hitting the target with a [Ranged] attack.",
					"def": 0.4
				}
			],
