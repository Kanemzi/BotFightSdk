			"lines": [
				{
					"kind": "Garrison",
					"doc": "GARRISON [BuildingId]\nUnits of [BuildingId] will come back inside their building."
				},
				{
					"kind": "Rally",
					"doc": "RALLY [BuildingId] [x] [y]\nUnits of [BuildingId] will go and stay stationary around [x, y]."
				},
				{
					"kind": "Gather",
					"doc": "GATHER [BuildingId] [x] [y] [radius]\nUnits of [BuildingId] will gather resources freely in a [radius] around [x, y]."
				},
				{
					"kind": "Construct",
					"doc": "CONSTRUCT [BuildingId] [TargetBuildingId]\nUnits of [BuildingId] will go inside neutral [TargetBuildingId] and start claiming or repairing it."
				},
				{
					"kind": "Siege",
					"doc": "SIEGE [BuildingId] [TargetBuildingId]\nUnits of [BuildingId] will attack [TargetBuildingId] to destroy it."
				}
			],
