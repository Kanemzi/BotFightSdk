					"baseStats": [
						{
							"stat": "MoveSpeed",
							"val": 0.8
						}
					],
					"name": "Cogneur",
					"doc": "Fight with a club and a shield. They are slow but have better resistance to arrows due to their [Armor]. When in garrison, they fight by throwing pebbles.",
					"behaviour": "Melee"
				},
				{
